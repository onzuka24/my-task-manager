{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "オーバーレイと介入パネルが必要とする最小の権限 (AD-3)。独自コマンドの invoke に権限は要らない。",
  "windows": [
    "main",
    "intervention"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-hide"
  ]
}
